{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextkit.dev/schemas/repo-graph.schema.json",
  "title": "ContextKit repository graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "graphs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "revision": { "type": ["string", "null"] },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "graphs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/graph" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "summary", "basis"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "external", "entrypoint", "module", "data-store", "agent",
            "policy", "observability", "config", "stage", "gate", "output"
          ]
        },
        "path": { "$ref": "#/$defs/relativePath" },
        "summary": { "type": "string", "minLength": 1 },
        "basis": { "enum": ["observed", "inferred"] },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "kind", "label", "basis"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "basis": { "enum": ["observed", "inferred"] },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "description", "nodes", "edges"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["architecture", "runtime-flow", "imports", "deployment"] },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 300,
          "items": { "$ref": "#/$defs/node" }
        },
        "edges": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/edge" }
        }
      }
    }
  }
}
