#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WORK_DIR_TO_CLEAN=""
KEEP_CLONE_ON_EXIT="false"

cleanup() {
  if [[ -n "$WORK_DIR_TO_CLEAN" && -d "$WORK_DIR_TO_CLEAN" && "$KEEP_CLONE_ON_EXIT" != "true" ]]; then
    rm -rf "$WORK_DIR_TO_CLEAN"
  fi
}

trap cleanup EXIT

COMMAND="${1:-}"

usage() {
  cat <<'EOF'
ContextKit - generate repository context packs for humans and AI systems.

Usage:
  contextkit generate <github-url-or-local-path> [--audience <name>] [--all] [--with-graph] [--agent <codex|claude>] [--regenerate] [--output <dir>] [--model <model>] [--max-turns <n>] [--keep-clone]
  contextkit help

Audiences:
  human         Generate HUMAN_OVERVIEW.md
  architecture  Generate ARCHITECTURE.md
  modules       Generate MODULE_GUIDE.md
  reviewer      Generate REVIEWER_GUIDE.md
  contributor   Generate CONTRIBUTOR_GUIDE.md
  agent         Generate AGENT_CONTEXT.md
  interviewer   Generate INTERVIEWER_BRIEF.md
  all           Generate all context files

Graph output:
  --with-graph  Also generate a validated REPO_GRAPH.json for the React viewer

Agents:
  codex         Use Codex CLI (default)
  claude        Use Claude Code CLI

Examples:
  contextkit generate https://github.com/owner/repo --audience human
  contextkit generate ~/work/private-repo --audience reviewer
  contextkit generate ~/work/private-repo --all --output ~/Desktop/repo-context
  contextkit generate ~/work/private-repo --all --regenerate
  contextkit generate ~/work/private-repo --all --agent claude
  contextkit generate ~/work/private-repo --all --with-graph
EOF
}

fail() {
  echo "contextkit: $*" >&2
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "missing required command: $1"
}

require_agent_cmd() {
  local agent="$1"
  if command -v "$agent" >/dev/null 2>&1; then
    return
  fi

  case "$agent" in
    codex) fail "missing required command: codex. Install Codex CLI and make sure it is on PATH, or run with --agent claude." ;;
    claude) fail "missing required command: claude. Install Claude Code CLI and make sure it is on PATH, or omit --agent claude to use Codex." ;;
    *) fail "invalid agent: $agent" ;;
  esac
}

slugify() {
  local value="$1"
  value="${value%.git}"
  value="$(basename "$value")"
  echo "$value" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9._-]+/-/g; s/^-+//; s/-+$//'
}

is_git_url() {
  [[ "$1" =~ ^https://github\.com/[^/]+/[^/]+/?$ ]] || [[ "$1" =~ ^git@github\.com:[^/]+/[^/]+\.git$ ]]
}

prompt_for_audience() {
  case "$1" in
    human) echo "$ROOT_DIR/contextkit/prompts/docs/human.md" ;;
    architecture) echo "$ROOT_DIR/contextkit/prompts/docs/architecture.md" ;;
    modules) echo "$ROOT_DIR/contextkit/prompts/docs/module-guide.md" ;;
    reviewer) echo "$ROOT_DIR/contextkit/prompts/docs/reviewer.md" ;;
    contributor) echo "$ROOT_DIR/contextkit/prompts/docs/contributor.md" ;;
    agent) echo "$ROOT_DIR/contextkit/prompts/docs/agent.md" ;;
    interviewer) echo "$ROOT_DIR/contextkit/prompts/docs/interviewer.md" ;;
    *) fail "unknown audience: $1" ;;
  esac
}

output_file_for_audience() {
  case "$1" in
    human) echo "HUMAN_OVERVIEW.md" ;;
    architecture) echo "ARCHITECTURE.md" ;;
    modules) echo "MODULE_GUIDE.md" ;;
    reviewer) echo "REVIEWER_GUIDE.md" ;;
    contributor) echo "CONTRIBUTOR_GUIDE.md" ;;
    agent) echo "AGENT_CONTEXT.md" ;;
    interviewer) echo "INTERVIEWER_BRIEF.md" ;;
    *) fail "unknown audience: $1" ;;
  esac
}

write_index() {
  local out_dir="$1"
  local source_label="$2"

  cat > "$out_dir/INDEX.md" <<EOF
# Context Pack Index

Source: \`$source_label\`

Generated by ContextKit.

## Files

EOF

  for f in HUMAN_OVERVIEW.md ARCHITECTURE.md MODULE_GUIDE.md REVIEWER_GUIDE.md CONTRIBUTOR_GUIDE.md AGENT_CONTEXT.md INTERVIEWER_BRIEF.md REPO_GRAPH.json; do
    if [[ -f "$out_dir/$f" ]]; then
      echo "- [$f](./$f)" >> "$out_dir/INDEX.md"
    fi
  done

  cat >> "$out_dir/INDEX.md" <<'EOF'

## Notes

- ContextKit writes this pack outside the target repository by default.
- Treat generated context as a starting point, not a replacement for code review.
- If something looks inaccurate, regenerate the specific audience file with a narrower request.
EOF
}

run_claude_generation() {
  local target_path="$1"
  local prompt="$2"
  local out_file="$3"
  local model="$4"
  local max_turns="$5"
  local system_prompt_file="${6:-$ROOT_DIR/contextkit/prompts/system.md}"
  local json_schema_file="${7:-}"

  local claude_args=(
    -p
    --append-system-prompt-file "$system_prompt_file"
    --add-dir "$target_path"
    --tools "Read,Glob,Grep"
    --max-turns "$max_turns"
    --output-format text
  )

  if [[ -n "$model" ]]; then
    claude_args+=(--model "$model")
  fi
  if [[ -n "$json_schema_file" ]]; then
    claude_args+=(--json-schema "$(node "$ROOT_DIR/scripts/claude-schema.mjs" "$json_schema_file")")
  fi

  local temp_out
  local log_file
  temp_out="$(mktemp "$out_file.tmp.XXXXXX")"
  log_file="$(mktemp "$out_file.log.XXXXXX")"

  if claude "${claude_args[@]}" "$prompt" > "$temp_out" 2> "$log_file"; then
    if [[ ! -s "$temp_out" ]]; then
      echo "contextkit: claude did not write output for $out_file" >&2
      if [[ -s "$log_file" ]]; then
        echo "contextkit: claude error output:" >&2
        tail -n 40 "$log_file" >&2 || true
      fi
      rm -f "$temp_out" "$log_file"
      return 1
    fi

    mv "$temp_out" "$out_file"
    rm -f "$log_file"
  else
    local status="$?"
    echo "contextkit: claude generation failed for $out_file (exit $status)" >&2
    if [[ -s "$log_file" ]]; then
      echo "contextkit: claude error output:" >&2
      tail -n 40 "$log_file" >&2 || true
    fi
    if [[ -s "$temp_out" ]]; then
      echo "contextkit: claude output:" >&2
      tail -n 40 "$temp_out" >&2 || true
    fi
    rm -f "$temp_out" "$log_file"
    return "$status"
  fi
}

run_codex_generation() {
  local target_path="$1"
  local prompt="$2"
  local out_file="$3"
  local model="$4"
  local system_prompt_file="${5:-$ROOT_DIR/contextkit/prompts/system.md}"

  local codex_prompt
  codex_prompt="$(cat "$system_prompt_file")

$prompt"

  local temp_out
  local log_file
  temp_out="$(mktemp "$out_file.tmp.XXXXXX")"
  log_file="$(mktemp "$out_file.log.XXXXXX")"

  local codex_args=(
    --ask-for-approval never
    exec
    --ephemeral
    --sandbox read-only
    --skip-git-repo-check
    --color never
    --output-last-message "$temp_out"
    --cd "$target_path"
  )

  if [[ -n "$model" ]]; then
    codex_args+=(--model "$model")
  fi

  if codex "${codex_args[@]}" - > "$log_file" 2>&1 <<< "$codex_prompt"; then
    if [[ ! -s "$temp_out" ]]; then
      echo "contextkit: codex did not write output for $out_file" >&2
      echo "contextkit: codex log: $log_file" >&2
      tail -n 20 "$log_file" >&2 || true
      rm -f "$temp_out"
      return 1
    fi

    mv "$temp_out" "$out_file"
    rm -f "$log_file"
  else
    local status="$?"
    echo "contextkit: codex generation failed for $out_file" >&2
    echo "contextkit: codex log: $log_file" >&2
    tail -n 20 "$log_file" >&2 || true
    rm -f "$temp_out"
    return "$status"
  fi
}

run_graph_generation() {
  local agent="$1"
  local target_path="$2"
  local source_label="$3"
  local repo_slug="$4"
  local out_dir="$5"
  local model="$6"
  local max_turns="$7"
  local revision=""

  revision="$(git -C "$target_path" rev-parse --short HEAD 2>/dev/null || true)"

  local prompt
  prompt="$(cat "$ROOT_DIR/contextkit/prompts/graph.md")

Target repository path:
$target_path

Repository slug:
$repo_slug

Source label:
$source_label

Git revision:
${revision:-unknown}

Output requirements:
- Return only the final JSON object.
- Do not wrap the JSON in code fences.
- Do not modify the target repository.
- Follow schema version 1 exactly.
"

  local out_file="$out_dir/REPO_GRAPH.json"
  local temp_file
  temp_file="$(mktemp "$out_dir/.REPO_GRAPH.json.tmp.XXXXXX")"
  echo "Generating $out_file with $agent"

  case "$agent" in
    claude)
      if run_claude_generation "$target_path" "$prompt" "$temp_file" "$model" "$max_turns" "$ROOT_DIR/contextkit/prompts/graph-system.md" "$ROOT_DIR/schemas/repo-graph.schema.json"; then
        :
      else
        local status="$?"
        rm -f "$temp_file"
        return "$status"
      fi
      ;;
    codex)
      if run_codex_generation "$target_path" "$prompt" "$temp_file" "$model" "$ROOT_DIR/contextkit/prompts/graph-system.md"; then
        :
      else
        local status="$?"
        rm -f "$temp_file"
        return "$status"
      fi
      ;;
    *) fail "invalid agent: $agent" ;;
  esac

  if ! node "$ROOT_DIR/scripts/validate-graph.mjs" "$temp_file" "$target_path"; then
    local diagnostic_file="$out_dir/.REPO_GRAPH.invalid-output.txt"
    echo "contextkit: generated graph was invalid; existing REPO_GRAPH.json was preserved" >&2
    echo "contextkit: invalid agent output saved to $diagnostic_file" >&2
    echo "contextkit: last lines of invalid output:" >&2
    tail -n 20 "$temp_file" >&2 || true
    mv "$temp_file" "$diagnostic_file"
    return 1
  fi

  mv "$temp_file" "$out_file"
}

run_generation() {
  local agent="$1"
  local target_path="$2"
  local source_label="$3"
  local audience="$4"
  local out_dir="$5"
  local model="$6"
  local max_turns="$7"

  local prompt_file
  prompt_file="$(prompt_for_audience "$audience")"

  local out_file
  out_file="$out_dir/$(output_file_for_audience "$audience")"

  local prompt
  prompt="$(cat "$prompt_file")

Target repository path:
$target_path

Source label:
$source_label

Output requirements:
- Return only the final markdown document.
- Do not wrap the document in code fences.
- Do not modify the target repository.
- Use file paths as evidence where helpful.
- Mark uncertain claims explicitly.
"

  echo "Generating $out_file with $agent"

  case "$agent" in
    claude) run_claude_generation "$target_path" "$prompt" "$out_file" "$model" "$max_turns" ;;
    codex) run_codex_generation "$target_path" "$prompt" "$out_file" "$model" ;;
    *) fail "invalid agent: $agent" ;;
  esac
}

generate() {
  local source="${1:-}"
  [[ -n "$source" ]] || fail "missing source. Provide a GitHub URL or local repo path."

  shift || true

  local audience="human"
  local all="false"
  local output=""
  local model=""
  local max_turns="12"
  local keep_clone="false"
  local regenerate="false"
  local agent="codex"
  local max_turns_set="false"
  local with_graph="false"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --audience)
        audience="${2:-}"
        [[ -n "$audience" ]] || fail "--audience requires a value"
        shift 2
        ;;
      --all)
        all="true"
        shift
        ;;
      --with-graph)
        with_graph="true"
        shift
        ;;
      --agent)
        agent="${2:-}"
        [[ -n "$agent" ]] || fail "--agent requires a value"
        shift 2
        ;;
      --regenerate)
        regenerate="true"
        shift
        ;;
      --output)
        output="${2:-}"
        [[ -n "$output" ]] || fail "--output requires a value"
        shift 2
        ;;
      --model)
        model="${2:-}"
        [[ -n "$model" ]] || fail "--model requires a value"
        shift 2
        ;;
      --max-turns)
        max_turns="${2:-}"
        [[ -n "$max_turns" ]] || fail "--max-turns requires a value"
        max_turns_set="true"
        shift 2
        ;;
      --keep-clone)
        keep_clone="true"
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        fail "unknown argument: $1"
        ;;
    esac
  done

  case "$agent" in
    codex|claude) ;;
    *) fail "invalid agent: $agent" ;;
  esac

  if [[ "$agent" == "codex" && "$max_turns_set" == "true" ]]; then
    fail "--max-turns can only be used with --agent claude"
  fi

  local work_dir=""
  local target_path=""
  local repo_slug=""

  if is_git_url "$source"; then
    repo_slug="$(slugify "$source")"
  else
    target_path="$(cd "$source" && pwd)"
    [[ -d "$target_path" ]] || fail "local repo path does not exist: $source"
    repo_slug="$(slugify "$target_path")"
  fi

  if [[ -z "$output" ]]; then
    output="$(pwd)/context-packs/$repo_slug"
  fi

  mkdir -p "$output"

  local audiences=()
  if [[ "$all" == "true" || "$audience" == "all" ]]; then
    audiences=(human architecture modules reviewer contributor agent interviewer)
  else
    audiences=("$audience")
  fi

  local pending_audiences=""
  local pending_count=0
  local generated_count=0
  local skipped_count=0
  local wrote_index="false"
  local graph_pending="false"

  for a in "${audiences[@]}"; do
    case "$a" in
      human|architecture|modules|reviewer|contributor|agent|interviewer) ;;
      *) fail "invalid audience: $a" ;;
    esac

    local out_file="$output/$(output_file_for_audience "$a")"
    if [[ "$regenerate" != "true" && -f "$out_file" ]]; then
      echo "Skipping existing $out_file"
      ((skipped_count += 1))
      continue
    fi

    pending_audiences="$pending_audiences $a"
    ((pending_count += 1))
  done

  local graph_file="$output/REPO_GRAPH.json"
  if [[ "$with_graph" == "true" ]]; then
    if [[ "$regenerate" != "true" && -f "$graph_file" ]]; then
      echo "Skipping existing $graph_file"
      ((skipped_count += 1))
    else
      graph_pending="true"
    fi
  fi

  if [[ "$pending_count" -gt 0 || "$graph_pending" == "true" ]]; then
    require_agent_cmd "$agent"
    if [[ "$graph_pending" == "true" ]]; then
      require_cmd node
    fi

    if is_git_url "$source"; then
      require_cmd git
      work_dir="$(mktemp -d "${TMPDIR:-/tmp}/contextkit.XXXXXX")"
      WORK_DIR_TO_CLEAN="$work_dir"
      KEEP_CLONE_ON_EXIT="$keep_clone"
      target_path="$work_dir/$repo_slug"

      echo "Cloning $source"
      git clone --depth 1 "$source" "$target_path" >/dev/null
    fi
  fi

  for a in $pending_audiences; do
    run_generation "$agent" "$target_path" "$source" "$a" "$output" "$model" "$max_turns"
    ((generated_count += 1))
  done

  if [[ "$graph_pending" == "true" ]]; then
    run_graph_generation "$agent" "$target_path" "$source" "$repo_slug" "$output" "$model" "$max_turns"
    ((generated_count += 1))
  fi

  local index_file="$output/INDEX.md"
  if [[ "$regenerate" == "true" || "$generated_count" -gt 0 || ! -f "$index_file" ]]; then
    write_index "$output" "$source"
    wrote_index="true"
  else
    echo "Skipping existing $index_file"
    ((skipped_count += 1))
  fi

  if [[ -n "$work_dir" && "$keep_clone" != "true" ]]; then
    rm -rf "$work_dir"
    WORK_DIR_TO_CLEAN=""
  elif [[ -n "$work_dir" ]]; then
    echo "Kept clone at $work_dir"
    WORK_DIR_TO_CLEAN=""
  fi

  echo
  if [[ "$generated_count" -eq 0 && "$skipped_count" -gt 0 && "$wrote_index" != "true" ]]; then
    echo "Context pack already up to date:"
  else
    echo "Context pack generated:"
  fi
  echo "$output"
}

case "$COMMAND" in
  generate)
    shift
    generate "$@"
    ;;
  help|-h|--help|"")
    usage
    ;;
  *)
    fail "unknown command: $COMMAND"
    ;;
esac
